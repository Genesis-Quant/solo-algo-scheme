// Session-local equivalent of Runtime factorPreprocess, without group labels.
def soloFactorPreprocess(
    rawFactorTable,
    factorCols,
    timeCol="time",
    codeCol="code",
    mktmvCol="circ_mv",
    industryCol="industry_l0") {
    factorColNames = soloFactorStringVector(factorCols)
    if (size(factorColNames) == 0) throw "factorCols must not be empty"
    soloFactorCheckColumns(rawFactorTable, symbol([timeCol, codeCol, mktmvCol, industryCol]))
    soloFactorCheckColumns(rawFactorTable, symbol(factorColNames))
    if (rawFactorTable.rows() == 0) throw "factorPreprocess input must not be empty"
    hasFactor = false
    for (factorCol in factorColNames) {
        hasFactor = hasFactor || any(!isNull(rawFactorTable[factorCol]))
    }
    if (!hasFactor) throw "factorPreprocess factors are all NULL"

    // Separate output avoids collisions with arbitrary named factor columns.
    workingTable = rawFactorTable.copy()
    workingTable.sortBy!(symbol([timeCol, codeCol]))
    result = workingTable.copy()
    outputCols = [timeCol, codeCol] join factorColNames
    extraCols = result.columnNames()[!(result.columnNames() in outputCols)]
    if (size(extraCols) > 0) result.dropColumns!(extraCols)
    result.dropColumns!(symbol(factorColNames))
    for (factorCol in factorColNames) {
        result[factorCol] = take(double(NULL), workingTable.rows())
    }
    reorderColumns!(result, outputCols)
    dateTable = <select distinct(_$timeCol) as date_col from workingTable>.eval()
    dates = dateTable.sortBy!(`date_col)[`date_col]
    rowOffset = 0l
    mktmvColSym = symbol([mktmvCol])[0]
    industryColSym = symbol([industryCol])[0]
    for (currentDate in dates) {
        // Direct vector selection prevents a factor named currentDate shadowing the scalar in SQL.
        crossSection = workingTable[workingTable[timeCol] == currentDate]
        crossSection.sortBy!(symbol([codeCol]))
        currentOffset = rowOffset
        rowOffset += crossSection.rows()
        for (factorCol in factorColNames) {
            factorColSym = symbol([string(factorCol)])[0]
            rawFactor = double(crossSection[factorColSym])
            rawMarketValue = double(crossSection[mktmvColSym])
            rawIndustry = string(crossSection[industryColSym])
            validMask = isValid(rawFactor) && isValid(rawMarketValue) && isValid(rawIndustry)
            if (sum(validMask) == 0) continue
            rowIds = currentOffset + long(at(validMask))
            marketValue = rawMarketValue[validMask]
            marketValue = iif(marketValue < 1, 1.0, marketValue)
            mv = soloFactorZScore(log(marketValue))
            industryValues = rawIndustry[validMask]
            y = soloFactorZScore(soloFactorClipMad(rawFactor[validMask]))
            regressionMask = isValid(y) && isValid(mv)
            if (sum(regressionMask) == 0) continue
            rowIds = rowIds[regressionMask]
            y = y[regressionMask]
            mv = mv[regressionMask]
            industryValues = industryValues[regressionMask]
            industries = sort(distinct(industryValues))
            x = matrix(mv)
            if (size(industries) > 1) {
                for (i in 1 .. (size(industries) - 1)) {
                    x = x join matrix(double(industryValues == industries[i]))
                }
            }
            design = matrix(take(1.0, size(y))) join x
            singularValues = svd(design, false, false)
            rankTolerance = max(singularValues) *
                max([rows(design), cols(design)]) * 2.220446049250313e-16
            effectiveRank = sum(singularValues > rankTolerance)
            if (size(y) <= effectiveRank) continue
            beta = ols(y, x, true, 0, "svd")
            fitted = beta[0] + beta[1] * mv
            if (size(industries) > 1) {
                for (i in 1 .. (size(industries) - 1)) {
                    fitted += beta[i + 1] * flatten(x[, i])
                }
            }
            rawResidual = y - fitted
            residualTolerance = max(abs(y)) *
                max([rows(design), cols(design)]) * 2.220446049250313e-16
            if (!isValid(stdp(rawResidual)) || stdp(rawResidual) <= residualTolerance) continue
            residual = soloFactorZScore(rawResidual)
            processedValues = result[factorColSym]
            processedValues[rowIds] = residual
            result[factorColSym] = processedValues
        }
    }
    return result
}
